# OneWipe Production Environment Variables
# Copy this file to .env and fill in your values

# Blockchain Configuration
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY_HERE
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Application Settings
NODE_ENV=production
DEFAULT_COUNTRY=USA
DEFAULT_CITY=San Francisco
DEFAULT_COUNTRY_CODE=US
DEFAULT_REGION=California
DEFAULT_REGION_CODE=CA

# Security Settings
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=10

# Monitoring (Optional)
ENABLE_MONITORING=true
LOG_LEVEL=info

# Service URLs (for production deployment)
# BACKEND_URL=https://your-domain.com
# BLOCKCHAIN_SERVICE_URL=https://blockchain.your-domain.com

# Database (if you add PostgreSQL later)
# DATABASE_URL=postgresql://user:password@localhost:5432/onewipe

# SSL/TLS (for production)
# SSL_KEY_PATH=/path/to/ssl/private.key
# SSL_CERT_PATH=/path/to/ssl/certificate.crt

# Backup Configuration (for production)
# BACKUP_ENABLED=true
# BACKUP_INTERVAL=24h
# BACKUP_STORAGE=s3://your-bucket/backups/

# Additional Security
# JWT_SECRET=your-jwt-secret-here
# CORS_ORIGIN=https://your-frontend-domain.com